{
  "name": "talisman",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:enhanced": "npm run deploy:check && next dev",
    "build": "next build",
    "build:enhanced": "npm run deploy:check && next build",
    "build:cap": "CAP_BUILD=1 next build",
    "start": "next start",
    "lint": "eslint",
    "icons": "node scripts/generate-icons.mjs",
    "cap:init": "npx cap init Alamat com.plaidelab.alamat --web-dir out",
    "cap:android": "npx cap add android",
    "cap:sync": "npx cap sync",
    "cap:run": "npx cap run android",
    "cap:build": "npm run build:cap && npm run icons && npm run cap:init && npm run cap:android && npm run cap:sync",
    "android": "npm run cap:build && npm run cap:run",
    "deploy:check": "node deploy-enhanced-graphics.mjs",
    "deploy:prepare": "npm run deploy:check && echo 'Deployment prepared successfully'",
    "deploy:test": "npm run deploy:check && npm run dev",
    "enhanced:quickstart": "echo 'Run: npm run deploy:check && npm run dev' && echo 'Then visit /play to see enhancements'"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.1",
    "@capacitor/core": "^8.5.1",
    "@types/three": "^0.185.4",
    "next": "16.3.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.1",
    "@gltf-transform/core": "^4.4.2",
    "@gltf-transform/extensions": "^4.4.2",
    "@gltf-transform/functions": "^4.4.2",
    "@netlify/plugin-nextjs": "^5.15.13",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.2",
    "sharp": "^0.35.4",
    "typescript": "^5"
  }
}
